# --- Transparency log storage (required in production) -----------------------
# Vercel Postgres / Neon connection string. Added automatically by the Vercel
# Postgres integration; without it the app falls back to a per-instance
# in-memory log and says so in the UI.
DATABASE_URL=

# --- Log signing key ---------------------------------------------------------
# 32-byte hex seed for the transparency log's STH signing key. Must be stable
# across deployments or previously issued tree heads stop verifying.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MODELRECEIPT_LOG_SEED=

# --- Model provider (all optional) -------------------------------------------
# With none set, the gateway serves a deterministic built-in demo model so the
# live demo works with no configuration. Set one to wrap real inference.
# Free tier: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
